# Keys and tokens for the job hunt. Copy to `.env` (same folder, gitignored)
# and fill in what you have. Everything here is optional: without a key the
# source that needs it is skipped and the rest of the search runs as usual.
#
#   cp .env.example .env
#
# The file is read by job-hunt/scripts/job_bot.py (jobbot/dotenv.py) and the
# Naukri screener. A value already in the environment always wins, so GitHub
# Actions secrets keep working unchanged.
#
# SECRETS ONLY. Your answers to setup questions and to recruiters' screening
# questions are NOT kept here - they live in data files that can hold options
# and per-job context:
#   Profile_Naukri_Screener-main/data/jobs/questions.yaml     asked, waiting for you
#   Profile_Naukri_Screener-main/data/jobs/answer_bank.yaml   answered once, reused
#   Profile_Naukri_Screener-main/jobs.yaml                    facts + answer rules + applicant:

# --- India coverage (Naukri / Indeed / LinkedIn through Apify) --------------
APIFY_TOKEN=
# Which Apify scrapers to use (default: naukri,indeed)
APIFY_SOURCES=

# --- extra job APIs ---------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# JSearch (Google Jobs) via RapidAPI
RAPIDAPI_KEY=
FIRECRAWL_API_KEY=

# --- recruiter / hiring-manager contacts ------------------------------------
SIGNALHIRE_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
